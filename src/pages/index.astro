---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TechPulse Pro</title>
  </head>
  <body class="bg-slate-950 text-slate-100 min-h-screen p-6 md:p-12">
    <div class="max-w-6xl mx-auto">
      <header class="mb-10 pb-6 border-b border-slate-800 flex justify-between items-center">
        <h1 class="text-3xl font-extrabold tracking-tight text-indigo-400">TechPulse<span class="text-white">Pro</span></h1>
        <span class="text-xs bg-indigo-500/10 text-indigo-400 px-3 py-1 rounded-full border border-indigo-500/20">AI Feed Active</span>
      </header>

      <main>
        <h2 class="text-xl font-bold mb-6 text-slate-300">Latest Articles ({posts.length})</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}`} class="group p-6 bg-slate-900 border border-slate-800 rounded-xl hover:border-indigo-500/50 transition duration-200 flex flex-col justify-between">
              <div>
                <span class="text-xs font-semibold text-indigo-400 uppercase tracking-wider mb-2 block">Article</span>
                <h3 class="text-lg font-bold group-hover:text-indigo-300 transition line-clamp-2">{post.data.title || post.slug.replaceAll('-', ' ')}</h3>
                <p class="text-slate-400 text-sm mt-2 line-clamp-3">{post.data.description || 'Click to read full details and specs...'}</p>
              </div>
              <div class="mt-6 text-xs text-slate-500 font-medium flex items-center gap-1 group-hover:text-indigo-400 transition">
                Read Full Guide &rarr;
              </div>
            </a>
          ))}
        </div>
      </main>
    </div>
  </body>
</html>
