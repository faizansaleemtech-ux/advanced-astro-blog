---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>TechPulse Pro</title>
  </head>
  <body class="bg-slate-900 text-white p-8">
    <h1 class="text-3xl font-bold mb-6">Latest Articles</h1>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}`} class="block p-6 bg-slate-800 rounded-lg hover:bg-slate-700 transition">
          <h2 class="text-xl font-bold mb-2">{post.data.title || post.slug}</h2>
          <p class="text-slate-400 text-sm">{post.data.description || 'Read article...'}</p>
        </a>
      ))}
    </div>
  </body>
</html>
